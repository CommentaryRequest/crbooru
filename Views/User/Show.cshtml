@{
    ViewData["Title"] = $"@{Model.Name}";
}

<h1><partial name="_UserLink" model="Model" /></h1>
<h3>Statistics</h3>
<table>
    <tr>
        <td><b>ID</b></td>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <td><b>Join Date</b></td>
        <td>@Model.CreatedAt</td>
    </tr>
    <tr>
        <td><b>Role</b></td>
        <td>@Model.Role</td>
    </tr>
    <tr>
        <td><b>Posts</b></td>
        <td><a asp-controller="Post" asp-action="Index" asp-route-tags="user:@Model.Name">@ViewData["PostCount"]</a></td>
    </tr>
    <tr>
        <td><b>Post Changes</b></td>
        <td><a asp-controller="PostVersion" asp-action="Index" asp-route-userid="@Model.Id">@ViewData["PostChangeCount"]</a></td>
    </tr>
</table>
@if (((List<Post>)ViewData["RecentPosts"]).Count != 0) {
    <h2>Recent Posts:</h2>
    <div class="post-list">
    @foreach (var post in (List<Post>)ViewData["RecentPosts"]) {
    <partial name="_PostThumbnail" model="post" />
    }
    </div>
}
