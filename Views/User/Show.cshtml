@{
    ViewData["Title"] = $"@{Model.Name}";
}

<h1><partial name="_UserLink" model="Model" /></h1>
<p><b>ID:</b> @Model.Id</p>
<p><b>Join Date:</b> @Model.CreatedAt</p>
<p><b>Role:</b> @Model.Role</p>
<p><b>Posts:</b> <a asp-controller="Post" asp-action="Index" asp-route-tags="user:@Model.Name">@ViewData["PostCount"]</a></p>
<p><b>Post Changes:</b> <a asp-controller="PostVersion" asp-action="Index" asp-route-userid="@Model.Id">@ViewData["PostChangeCount"]</a></p>
@if (((List<Post>)ViewData["RecentPosts"]).Count != 0) {
    <h2>Recent Posts:</h2>
    <div class="post-list">
    @foreach (var post in (List<Post>)ViewData["RecentPosts"]) {
    <partial name="_PostThumbnail" model="post" />
    }
    </div>
}
