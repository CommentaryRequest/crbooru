@model CRbooru.Models.ViewModels.TagImplicationListViewModel
@{
    ViewData["Title"] = "Tag Implications";
}

<table class="striped">
    <tr>
        <th>Antecedent</th>
        <th>Consequent</th>
    </tr>
    @foreach (var implication in Model.TagImplications) {
    <tr>
        <td><partial name="_TagLink" model="implication.Antecedent" /></td>
        <td><partial name="_TagLink" model="implication.Consequent" /></td>
    </tr>
    }
</table>

<partial name="_Paginator" model="@Model" />