@{
    ViewData["Title"] = "Post History";
}

@if (ViewData["PostId"] != null) {
<h1>Post History: <a asp-controller="Post" asp-action="Show" asp-route-id="@ViewData["PostId"]">post #@ViewData["PostId"]</a></h1>
} else if (ViewData["UserId"] != null) {
<h1>Post History: <partial name="_UserLink" model="@ViewData["User"]" /></h1>
} else {
<h1>Post History</h1>
}

<table class="striped">
    <tr>
        <th>Post</th>
        <th>Version</th>
        <th>Changes</th>
        <th>User</th>
        <th>Updated at</th>
        <th>Actions</th>
    </tr>
    @for (var i = 0; i < Model.Count; i++) {
    var version = Model[i];
    var tags = (IEnumerable<Tag>)version.Post.Tags;
    <tr>
        <td>
            <partial name="_PostThumbnail" model="@version.Post" />
        </td>
        <td>
            @(version.PostId).@version.Number
        </td>
        <td>
            @if (version.AddedTags != null) {
                @foreach (var tag in version.AddedTags) {
                    var isObsolete = !tags.Any(t => t.Name == tag);
                <span class="added-tag @(isObsolete ? "obsolete-tag" : "")">+@tag</span>
                }
            }
            @if (version.RemovedTags != null) {
                @foreach (var tag in version.RemovedTags) {
                    var isObsolete = tags.Any(t => t.Name == tag);
                <span class="removed-tag @(isObsolete ? "obsolete-tag" : "")">-@tag</span>
                }
            }
            @if (version.NewRating != null) {
                    var isObsolete = version.Post.Rating != version.NewRating;
                <span class="changed-tag @(isObsolete ? "obsolete-tag" : "")">rating:@version.NewRating.ToString().ToLower()[0]</span>
            }
            @if (version.SourceChanged) {
                    var isObsolete = version.Post.Source != version.NewSource;
                @if (version.NewSource == null) {
                <span class="changed-tag @(isObsolete ? "obsolete-tag" : "")">source:none</span>
                } else {
                <span class="changed-tag @(isObsolete ? "obsolete-tag" : "")">source:@version.NewSource</span>
                }
            }
        </td>
        <td>
            <partial name="_UserLink" model="version.User" />
        </td>
        <td>
            @version.CreatedAt
        </td>
        <td>
            @if (version.Number != 1) {
                <a asp-action="Undo" asp-route-id="@version.Id">Undo</a>
            }
        </td>
    </tr>
    }
</table>
