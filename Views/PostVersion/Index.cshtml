@{
    ViewData["Title"] = "Post History";
}

<h1>Post History: <a asp-controller="Post" asp-action="Show" asp-route-id="@ViewData["PostId"]">post #@ViewData["PostId"]</a></h1>

<table>
    <tr>
        <th>Changes</th>
        <th>User</th>
        <th>Updated at</th>
    </tr>
    @foreach (var version in Model) {
    <tr>
        <td>
            @if (version.AddedTags != null) {
            <p><b>Added:</b> @(string.Join(' ', version.AddedTags))</p>
            }
            @if (version.RemovedTags != null) {
            <p><b>Removed:</b> @(string.Join(' ', version.RemovedTags))</p>
            }
            @if (version.NewRating != null) {
            <p><b>Rating:</b> @version.NewRating</p>
            }
            @if (version.NewSource != null) {
            <p><b>Source:</b> @version.NewSource</p>
            }
        </td>
        <td>
            <partial name="_UserLink" model="version.User" />
        </td>
        <td>
            @version.CreatedAt
        </td>
    </tr>
    }
</table>
