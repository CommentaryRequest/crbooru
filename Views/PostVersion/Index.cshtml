@{
    ViewData["Title"] = "Post History";
}

@if (ViewData["PostId"] != null) {
<h1>Post History: <a asp-controller="Post" asp-action="Show" asp-route-id="@ViewData["PostId"]">post #@ViewData["PostId"]</a></h1>
} else if (ViewData["UserId"] != null) {
<h1>Post History: <partial name="_UserLink" model="@ViewData["User"]" /></h1>
} else {
<h1>Post History</h1>
}

<table>
    <tr>
        <th>Version</th>
        <th>Changes</th>
        <th>User</th>
        <th>Updated at</th>
    </tr>
    @for (var i = 0; i < Model.Count; i++) {
    var version = @Model[i];
    <tr>
        <td>
            @version.PostId
        </td>
        <td>
            @if (version.AddedTags != null) {
                @foreach (var tag in version.AddedTags) {
                <span class="added-tag">+@tag</span>
                }
            }
            @if (version.RemovedTags != null) {
                @foreach (var tag in version.RemovedTags) {
                <span class="removed-tag">-@tag</span>
                }
            }
            @if (version.NewRating != null) {
                <span class="changed-tag">rating:@version.NewRating.ToString().ToLower()[0]</span>
            }
            @if (version.SourceChanged) {
                @if (version.NewSource == null) {
                <span class="changed-tag">source:none</span>
                } else {
                <span class="changed-tag">source:@version.NewSource</span>
                }
            }
        </td>
        <td>
            <partial name="_UserLink" model="version.User" />
        </td>
        <td>
            @version.CreatedAt
        </td>
    </tr>
    }
</table>
