<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CRbooru</title>
    <script type="importmap"></script>
</head>
<body>
    <h1>CRbooru</h1>
    @if (User.Identity?.IsAuthenticated != true) {
        <a asp-controller="User" asp-action="Login">Login</a>
    } else {
        <a asp-controller="User" asp-action="Profile">My Account</a>
    }
    | <a asp-controller="Post" asp-action="Index">Posts</a>
    <hr>
    @{
        switch (ViewData["Controller"]) {
            case "User":
                <text>
                <a asp-controller="User" asp-action="Index">Listing</a>
                </text>
                if (User.Identity?.IsAuthenticated == true && @Model?.Id == int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier))) {
                    <text>
                    | <a asp-controller="User" asp-action="Logout">Logout</a>
                    </text>
                }
                break;
            case "Post":
                <text>
                <a asp-controller="Post" asp-action="Index">Listing</a>
                | <a asp-controller="Upload" asp-action="ShowCreate">Upload</a>
                </text>
                break;
            case "Upload":
                <text>
                <a asp-controller="Upload" asp-action="ShowCreate">Upload</a>
                </text>
                break;
        }
    }
    <hr>

    @if (TempData.ContainsKey("Error")) {
        <div id="error-message">
            <p><b>Error:</b> @TempData["Error"]</p>
        </div>
    }
    @if (TempData.ContainsKey("Information")) {
        <div id="info-message">
            <p><b>Notice:</b> @TempData["Information"]</p>
        </div>
    }
    <div id="container">
        @RenderBody()
    </div>
</body>
</html>
