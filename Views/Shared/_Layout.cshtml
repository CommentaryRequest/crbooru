<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CRbooru</title>
    <script type="importmap"></script>
</head>
<body>
    @if (ViewData.ContainsKey("Error")) {
        <div id="error-message">
            <p><b>Error:</b> @ViewData["Error"]</p>
        </div>
    }
    @if (ViewData.ContainsKey("Information")) {
        <div id="info-message">
            <p><b>Notice:</b> @ViewData["Information"]</p>
        </div>
    }
    <div id="container">
        @RenderBody()
    </div>
</body>
</html>
