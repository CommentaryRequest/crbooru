@model CRbooru.Models.ViewModels.IPaginatedViewModel

<div id="paginator">
    <p>
        @if (Model.PaginationInfo.TotalPages() > 1) {
            @if (Model.PaginationInfo.ClampedPage() > 1) {
                <a asp-action="Index" asp-all-route-data="@Model.RouteValues" asp-route-page="@(Model.PaginationInfo.ClampedPage() - 1)" asp-route-limit="@Model.PaginationInfo.ClampedLimit()">&lt;</a>
                <a asp-action="Index" asp-all-route-data="@Model.RouteValues" asp-route-page="1" asp-route-limit="@Model.PaginationInfo.ClampedLimit()">First</a>
            }

            <text>
            @Model.PaginationInfo.ClampedPage() / @Model.PaginationInfo.TotalPages()
            </text>
            
            @if (Model.PaginationInfo.Page < Model.PaginationInfo.TotalPages()) {
                <a asp-action="Index" asp-all-route-data="@Model.RouteValues" asp-route-page="@Model.PaginationInfo.TotalPages()" asp-route-limit="@Model.PaginationInfo.ClampedLimit()">Last</a>
                <a asp-action="Index" asp-all-route-data="@Model.RouteValues" asp-route-page="@(Model.PaginationInfo.ClampedPage() + 1)" asp-route-limit="@Model.PaginationInfo.ClampedLimit()">&gt;</a>
            }
        }
    </p>
</div>