@model TagListViewModel
@{
    ViewData["Title"] = "Tags";
}

<table class="striped">
    <tr>
        <th>Name</th>
        <th>Post count</th>
    </tr>
    @foreach (var tag in Model.Tags) {
        <tr>
            <td><partial name="_TagLink" model="tag" /></td>
            <td>@tag.PostCount</td>
        </tr>
    }
</table>

<partial name="_Paginator" model="@Model" />
