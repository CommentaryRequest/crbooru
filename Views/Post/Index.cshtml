@model PostListViewModel
@{
    ViewData["Title"] = String.IsNullOrWhiteSpace(Model.SearchQuery) ? "Posts" : $"Search: {Model.SearchQuery}";
}

<div id="post-list">
    <div id="post-list-sidebar">
        <h4>Search</h4>
        <form asp-controller="Post" asp-action="Index" method="get">
            <input type="text" name="tags" value="@Model.SearchQuery" data-shortcut="q">
            <input type="submit" value="Search">
        </form>
        <br>
        <h4>Tags</h4>
        <ul>
            @foreach (var tag in (IEnumerable<Tag>)(Model.RelatedTags)) {
                <li><partial name="_TagLinkCount" model="tag" /></li>
            }
        </ul>
    </div>
    <div id="post-list-gallery">
        <div class="post-list">
            @foreach (var post in Model.Posts) {
            <partial name="_PostThumbnail" model="post" />
            }

            @if (Model.Posts.Count == 0) {
            <p>Nobody here but us chickens!</p>
            }
        </div>

        <partial name="_Paginator" model="@Model" />
    </div>
</div>
