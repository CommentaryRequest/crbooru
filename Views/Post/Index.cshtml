@{
    ViewData["Title"] = "Posts";
}

@if (Model.Count == 0) {
<p>Nobody here but us chickens!</p>
}

@foreach (var post in Model) {
<a asp-controller="Post" asp-action="Show" asp-route-id="@post.Id">
    <img src="@post.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Thumbnail)" alt="post #@post.Id">
</a>
}
