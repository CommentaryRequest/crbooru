@{
    ViewData["Title"] = String.IsNullOrWhiteSpace((string?)ViewData["Tags"]) ? "Posts" : $"Search: {ViewData["Tags"]}";
}

<div id="post-list">
    <div id="post-list-sidebar">
        <h4>Search</h4>
        <form asp-controller="Post" asp-action="Index" method="get">
            <input type="text" name="tags" value="@ViewData["Tags"]" data-shortcut="q">
            <input type="submit" value="Search">
        </form>
        <br>
        <h4>Tags</h4>
        <ul>
            @foreach (var tag in (IEnumerable<Tag>)(ViewData["RelatedTags"])) {
                <li><partial name="_TagLink" model="tag" /></li>
            }
        </ul>
    </div>
    <div id="post-list-gallery">
        <div class="post-list">
            @foreach (var post in Model) {
            <partial name="_PostThumbnail" model="post" />
            }

            @if (Model.Count == 0) {
            <p>Nobody here but us chickens!</p>
            }
        </div>

        <div id="paginator">
            <p>
                @if ((int)ViewData["Page"] > 1) {
                <a asp-action="Index" asp-route-tags="@ViewData["Tags"]" asp-route-page="@((int)ViewData["Page"] - 1)">&lt;</a>
                <a asp-action="Index" asp-route-tags="@ViewData["Tags"]" asp-route-page="1">First</a>
                }
                Page @ViewData["Page"] / @ViewData["TotalPages"]
                @if ((int)ViewData["Page"] < (int)ViewData["TotalPages"]) {
                <a asp-action="Index" asp-route-tags="@ViewData["Tags"]" asp-route-page="@((int)ViewData["Page"] + 1)">&gt;</a>
                <a asp-action="Index" asp-route-tags="@ViewData["Tags"]" asp-route-page="@ViewData["TotalPages"]">Last</a>
                }
            </p>
        </div>
    </div>
</div>
