@model PostListViewModel
@{
    ViewData["Title"] = String.IsNullOrWhiteSpace(Model.SearchQuery) ? "Posts" : $"Search: {Model.SearchQuery}";
}

<div id="post-list">
    <div id="post-list-sidebar">
        <h4>Search</h4>
        <form asp-controller="Post" asp-action="Index" method="get">
            <input type="text" name="tags" value="@Model.SearchQuery" data-shortcut="q">
            <input type="submit" value="Search">
        </form>
        <br>
        <h4>Tags</h4>
        <ul>
            @foreach (var tag in (IEnumerable<Tag>)(Model.RelatedTags)) {
                <li><partial name="_TagLink" model="tag" /></li>
            }
        </ul>
    </div>
    <div id="post-list-gallery">
        <div class="post-list">
            @foreach (var post in Model.Posts) {
            <partial name="_PostThumbnail" model="post" />
            }

            @if (Model.Posts.Count == 0) {
            <p>Nobody here but us chickens!</p>
            }
        </div>

        <div id="paginator">
            <p>
                @if (Model.Page > 1) {
                <a asp-action="Index" asp-route-tags="Model.SearchQuery" asp-route-page="@(Model.Page - 1)">&lt;</a>
                <a asp-action="Index" asp-route-tags="@Model.SearchQuery" asp-route-page="1">First</a>
                }
                Page @Model.Page / @Model.TotalPages
                @if (Model.Page < Model.TotalPages) {
                <a asp-action="Index" asp-route-tags="@Model.SearchQuery" asp-route-page="@(Model.Page + 1)">&gt;</a>
                <a asp-action="Index" asp-route-tags="@Model.SearchQuery" asp-route-page="@Model.TotalPages">Last</a>
                }
            </p>
        </div>
    </div>
</div>
