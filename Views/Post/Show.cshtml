@model Post
@using System.Linq
@using CRbooru.Logical
@{
    ViewData["Title"] = $"post #{Model.Id}";

    var formModel = new PostFormModel {
        Source = Model.Source,
        Rating = Model.Rating,
        TagString = TagParser.BuildTagString(Model.Tags)
    };

    var artistTags = Model.Tags.Where(tag => tag.Category == TagCategory.Artist);
    var copyrightTags = Model.Tags.Where(tag => tag.Category == TagCategory.Copyright);
    var characterTags = Model.Tags.Where(tag => tag.Category == TagCategory.Character);
    var generalTags = Model.Tags.Where(tag => tag.Category == TagCategory.General);
    var metaTags = Model.Tags.Where(tag => tag.Category == TagCategory.Meta);

    void RenderTagList(string categoryName, IEnumerable<Tag> tagList)
    {
        @if (tagList.Count() != 0) {
            <h4 class="category-heading">@categoryName</h4>
            <ul>
            @foreach (var tag in tagList) {
                <li><a class="tag-@(categoryName.ToLower())">@tag.Name</a> (@tag.PostCount)</li>
            }
            </ul>
        }
    }
}

<div id="post-view">
    <div id="post-sidebar">
        <div id="tag-list">
            <h3>Tags (@Model.Tags.Count())</h3>
            @{
                RenderTagList("Artist", artistTags);
                RenderTagList("Copyright", copyrightTags);
                RenderTagList("Character", characterTags);
                RenderTagList("General", generalTags);
                RenderTagList("Meta", metaTags);
            }
        </div>
        <div id="post-information">
            <h3>Information</h3>
            <ul>
                <li><b>ID:</b> @Model.Id</li>
                <li><b>Uploader:</b> <partial name="_UserLink" model="Model.Uploader"></li>
                <li><b>Date:</b> @Model.CreatedAt</li>
                <li><b>Rating:</b> @Model.Rating</li>
                <li><b>Size:</b> <a asp-controller="MediaAsset" asp-action="Show" asp-route-id="@Model.MediaAsset.Id">@Html.MediaAssetSize(Model.MediaAsset)</a></li>
                <li><b>Source:</b>
                @if (!string.IsNullOrEmpty(Model.Source) && (Uri.TryCreate(Model.Source, UriKind.Absolute, out var uri)
                && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))) {
                    <a href="@Model.Source">@Model.Source</a>
                } else if (string.IsNullOrWhiteSpace(Model.Source)) {
                    <i>none</i>
                } else {
                    @Model.Source
                }
                </li>
            </ul>
        </div>
    </div>

    <div id="post-image">
        <img src="@Model.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Sample)">

        @if (User.Identity?.IsAuthenticated == true) {
        <h3>Edit</h3>
        <form asp-controller="Post" asp-action="Edit" method="post">
            <input type="hidden" name="postid" value="@Model.Id">
            <partial name="_PostFields" model="formModel">
            <input type="submit" value="Edit">
        </form>
        } else {
        <p><a asp-controller="User" asp-action="Login">Log in</a> to edit posts.</p>
        }
    </div>
</div>
