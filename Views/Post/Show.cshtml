@model PostViewModel
@using System.Linq
@using CRbooru.Logical
@{
    var artistTags = Model.Post.Tags.Where(tag => tag.Category == TagCategory.Artist);
    var copyrightTags = Model.Post.Tags.Where(tag => tag.Category == TagCategory.Copyright);
    var characterTags = Model.Post.Tags.Where(tag => tag.Category == TagCategory.Character);
    var generalTags = Model.Post.Tags.Where(tag => tag.Category == TagCategory.General);
    var metaTags = Model.Post.Tags.Where(tag => tag.Category == TagCategory.Meta);

    ViewData["Title"] = EssentialTagStringBuilder.Build(Model.Post.Tags.ToList(), Model.Post.Id);

    var formModel = new PostFormModel {
        Source = Model.Post.Source,
        Rating = Model.Post.Rating,
        TagString = TagParser.BuildTagString(Model.Post.Tags),
        Parent = Model.Post.ParentId
    };

    async Task RenderTagList(string categoryName, IEnumerable<Tag> tagList)
    {
        @if (tagList.Count() != 0) {
            <h4 class="category-heading">@categoryName</h4>
            <ul>
            @foreach (var tag in tagList) {
                <li><partial name="_TagLink" model="tag" /></li>
            }
            </ul>
        }
    }
}

<div id="post-view">
    <div id="post-sidebar">
        <div id="tag-list">
            <h3>Tags (@Model.Post.Tags.Count())</h3>
            @{
                await RenderTagList("Artist", artistTags);
                await RenderTagList("Copyright", copyrightTags);
                await RenderTagList("Character", characterTags);
                await RenderTagList("General", generalTags);
                await RenderTagList("Meta", metaTags);
            }
        </div>
        <div id="post-information">
            <h3>Information</h3>
            <ul>
                <li><b>ID:</b> @Model.Post.Id</li>
                <li><b>Uploader:</b> <partial name="_UserLink" model="Model.Post.Uploader" /> <a asp-controller="Post" asp-action="Index" asp-route-tags="user:@Model.Post.Uploader.Name">»</a></li>
                <li><b>Date:</b> @Model.Post.CreatedAt</li>
                <li><b>Rating:</b> @Model.Post.Rating</li>
                <li><b>Size:</b> <a asp-controller="MediaAsset" asp-action="Show" asp-route-id="@Model.Post.MediaAsset.Id">@Html.MediaAssetSize(Model.Post.MediaAsset)</a></li>
                <li><b>Source:</b>
                @if (!string.IsNullOrEmpty(Model.Post.Source) && (Uri.TryCreate(Model.Post.Source, UriKind.Absolute, out var uri)
                && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))) {
                    <a href="@Model.Post.Source">@Model.Post.Source</a>
                } else if (string.IsNullOrWhiteSpace(Model.Post.Source)) {
                    <i>none</i>
                } else {
                    @Model.Post.Source
                }
                </li>
            </ul>
        </div>
        <div id="post-history">
            <h3>History</h3>
            <ul>
                <li><a asp-controller="PostVersion" asp-action="Index" asp-route-postid="@Model.Post.Id">Tags</a></li>
            </ul>
        </div>
        <div id="post-options">
            <h3>Options</h3>
            <ul>
                <li><a href="@Model.Post.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Original)" download="@(Model.Post.MediaAsset.Md5).@Model.Post.MediaAsset.FileType">Download</a></li>
            </ul>
        </div>
    </div>

    <div id="post-image">
        @if (Model.Pools.Count() != 0) {
        <div id="pool-notice">
            <ul>
            @foreach (var pool in Model.Pools) {
                <li><a asp-controller="Pool" asp-action="Show" asp-route-id="@pool.Id">Pool: @pool.Name</a></li>
            }
            </ul>
        </div>
        }

        @if (Model.Post.Parent != null) {
        var siblingCount = Model.Post.Parent.Children.Count() - 1;
        <div id="parent-notice">
            This post belongs to a <a asp-action="Index" asp-route-tags="parent:@Model.Post.ParentId">parent</a>@if (siblingCount > 0) {<text> and has <a asp-action="Index" asp-route-tags="parent:@Model.Post.ParentId">@siblingCount sibling@(siblingCount == 1 ? "" : "s")</a></text>}:
            <div class="thumbnail-row">
                <div class="thumbnail-small"><partial name="_PostThumbnail" model="Model.Post.Parent" /></div>
                @foreach (var sibling in Model.Post.Parent.Children) {
                <div class="thumbnail-small"><partial name="_PostThumbnail" model="sibling" /></div>
                }
            </div>
        </div>
        }
        @if (Model.Post.Children.Count() != 0) {
        var childCount = Model.Post.Children.Count();
        <div id="child-notice">
            This post has <a asp-action="Index" asp-route-tags="parent:@Model.Post.Id">@childCount child@(childCount == 1 ? "" : "ren")</a>:
            <div class="thumbnail-row">
                <div class="thumbnail-small"><partial name="_PostThumbnail" model="Model.Post" /></div>
                @foreach (var sibling in Model.Post.Children) {
                <div class="thumbnail-small"><partial name="_PostThumbnail" model="sibling" /></div>
                }
            </div>
        </div>
        }
        <img src="@Model.Post.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Sample)">

        @if (User.Identity?.IsAuthenticated == true) {
        <div id="edit">
            <a href="#edit" id="post-edit-link" data-shortcut="e">Edit</a>
            <form asp-controller="Post" asp-action="Edit" method="post" id="post-edit-form" style="display: none">
                <input type="hidden" name="postid" value="@Model.Post.Id">
                <partial name="_PostFields" model="formModel" />
                <input type="submit" value="Submit">
            </form>
        </div>
        } else {
        <p><a asp-controller="User" asp-action="Login">Log in</a> to edit posts.</p>
        }
    </div>
</div>

<script src="/js/post_show.js"></script>
