@model UploadViewModel
@{
    ViewData["Title"] = "Upload";
    var formModel = new PostFormModel {
        Source = "",
        Rating = PostRating.General,
        TagString = ""
    };
}

@if (Model.Upload.Status == UploadStatus.Pending) {
    <p>This upload is still processing...</p>
} else if (Model.Upload.Status == UploadStatus.Error) {
    <p>Upload failed: @Model.Upload.StatusMessage</p>
} else if (Model.MediaAsset != null) {
<div id="upload-view">
    <div id="upload-image">
        <img src="@Model.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Original)">
        <br>
        <a asp-controller="MediaAsset" asp-action="Show" asp-route-id="@Model.MediaAsset.Id">@Html.MediaAssetSize(Model.MediaAsset)</a>
    </div>
    <div id="upload-tags">
        <form asp-controller="Post" asp-action="Create" method="post">
            <input type="hidden" name="mediaassetid" value="@Model.MediaAsset.Id">
            <input type="hidden" name="uploadid" value="@Model.Upload.Id">
            <partial name="_PostFields" model="formModel">
            <input type="submit" value="Post">
        </form>
    </div>
</div>
}
