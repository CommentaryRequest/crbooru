@model Upload
@{
    ViewData["Title"] = "Upload";
}

@if (Model.Status == UploadStatus.Pending) {
    <p>This upload is still processing...</p>
} else if (Model.Status == UploadStatus.Error) {
    <p>Upload failed: @Model.StatusMessage</p>
} else {
<form asp-controller="Post" asp-action="Create" method="post">
    <input type="hidden" name="mediaassetid" value="@Model.MediaAssets[0].Id">
    <label for="rating">Rating</label>
    <select name="rating">
        <option value="general" selected="selected">General</option>
        <option value="sensitive">Sensitive</option>
        <option value="questionable">Questionable</option>
        <option value="explicit">Explicit</option>
    </select>
    <p></p>
    <label for="tagstring">Tags</label>
    <textarea name="tagstring" cols="50" rows="5"></textarea>
    <p></p>
    <input type="submit" value="Post">
    <p></p>
    <img src="@Model.MediaAssets[0].GetFilePath("/images", MediaAssetVariantType.Original)">
</form>
}
