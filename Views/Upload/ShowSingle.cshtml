@using CRbooru.Models.FormModels
@model CRbooru.Models.ViewModels.UploadViewModel
@{
    ViewData["Title"] = "Upload";
    var formModel = new PostFormModel {
        Source = "",
        Rating = PostRating.General,
        TagString = ""
    };
}

@if (Model.Upload.Status == UploadStatus.Pending) {
    <p>This upload is still processing...</p>
} else if (Model.Upload.Status == UploadStatus.Error) {
    <p>Upload failed: @Model.Upload.StatusMessage</p>
} else if (Model.MediaAsset != null) {
<div id="upload-view">
    <div id="upload-image">
        <img src="@Model.MediaAsset.GetFilePath("/images", MediaAssetVariantType.Original)">
        <br>
        <a asp-controller="MediaAsset" asp-action="Show" asp-route-id="@Model.MediaAsset.Id">@Html.MediaAssetSize(Model.MediaAsset)</a>
    </div>
    <div id="upload-tags">
        <form asp-controller="Post" asp-action="Create" method="post">
            <input type="hidden" name="mediaassetid" value="@Model.MediaAsset.Id">
            <input type="hidden" name="uploadid" value="@Model.Upload.Id">
            <partial name="_PostFields" model="formModel" />
            <label for="commentaryoriginaltitle">Original title</label><br>
            <input type="text" name="commentaryoriginaltitle" id="commentaryoriginaltitle">
            <p></p>
            <label for="commentaryoriginaldescription">Original description</label><br>
            <textarea name="commentaryoriginaldescription" id="commentaryoriginaldescription" rows="10" cols="50"></textarea>
            <p></p>
            <label for="commentarytranslatedtitle">Translated title</label><br>
            <input type="text" name="commentarytranslatedtitle" id="commentarytranslatedtitle">
            <p></p>
            <label for="commentarytranslateddescription" id="commentarytranslateddescription">Translated description</label><br>
            <textarea name="commentarytranslateddescription" id="commentarytranslateddescription" rows="10" cols="50"></textarea>
            <p></p>
            <input type="submit" value="Post">
        </form>
    </div>
</div>
}
