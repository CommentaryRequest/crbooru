@model MediaAssetListViewModel
@{
    ViewData["Title"] = "Media Assets";
}

<div class="post-list">
    @foreach (var mediaAsset in Model.MediaAssets) {
    <a asp-controller="MediaAsset" asp-action="Show" asp-route-id="@mediaAsset.Id" class="post-thumbnail">
        <partial name="_MediaAssetThumbnail" model="mediaAsset" />
    </a>
    }
</div>

<partial name="_Paginator" model="Model" />