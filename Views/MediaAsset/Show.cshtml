@model MediaAsset
@{
    ViewData["Title"] = "Media Asset";
}

<div id="media-asset-view">
    <div id="media-asset-sidebar">
        <ul>
            <li><b>ID</b>: @Model.Id</li>
            <li><b>MD5</b>: @Model.Md5</li>
            <li><b>Pixel hash:</b> @Model.PixelHash</li>
            <li><b>File type:</b> @Model.FileType</li>
            <li><b>Size:</b> @Html.MediaAssetSize(Model)</li>
            <li><b>Created at:</b> @Model.CreatedAt</li>
        </ul>
    </div>
    <div id="media-asset-image">
        <img src="@Model.GetFilePath("/images", MediaAssetVariantType.Original)">
    </div>
</div>
